# Guardiões do Sábado — variáveis de ambiente do servidor
# No Railway: aba "Variables" do serviço. Nunca commite o arquivo .env real.

# --- Conta do líder (superadmin). Criada no primeiro início se ainda não existir. ---
GS_ADMIN_USER=Líder
# OBRIGATÓRIA no primeiro início (mínimo 10 caracteres). Use uma senha longa e única.
GS_ADMIN_PASSWORD=
# Esqueceu a senha do líder? Coloque a senha nova acima, ligue isto (=1), reinicie, e DEPOIS REMOVA esta linha.
# GS_ADMIN_RESET=1

# --- Banco de dados (SQLite) ---
# Em produção aponte para o Volume persistente (ex.: montado em /data). Sem volume, o banco some a cada deploy.
GS_DB_PATH=/data/guardioes.db

# --- Rede / cookies ---
# Em produção (HTTPS) deixe como está. Use 0 SÓ para testar em http://localhost.
GS_COOKIE_SECURE=1
# Quantos proxies existem na frente do app (Railway, Nginx, Cloudflare...). Normalmente 1.
GS_TRUST_PROXY=1
# Porta (o Railway define sozinho)
# PORT=3000

# --- Aviso de privacidade mostrado aos jovens e responsáveis ---
GS_RESPONSAVEL=Nome do responsável pelo grupo / igreja
GS_CONTATO=e-mail ou WhatsApp para pedidos sobre os dados
